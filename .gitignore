# Whitelist: this repository lives in the root of an Orbiter 2024 installation (branch 2024).
# Everything is ignored except the project files listed below. Orbiter 2016 was the proving ground; since 2026-10-04
# everything lives here (Tantra's sources, design and tools moved from branch 2016).
/*
!/.gitignore
!/README.md

# --- OrbiterCrew for Orbiter 2024: sources, config, scenarios ---
!/Orbitersdk/
/Orbitersdk/*
!/Orbitersdk/OrbiterCrew/
/Orbitersdk/OrbiterCrew/build/
/Orbitersdk/OrbiterCrew/*.user
!/Config/
/Config/*
!/Config/Vessels/
/Config/Vessels/*
!/Config/Vessels/OrbiterCrew/
!/Config/OrbiterCrew/
!/Config/Tantra/
!/Scenarios/
/Scenarios/*
!/Scenarios/OrbiterCrew/

# --- design: Blender scripts, sketches, mocap, audio (tools and generated outputs stay local) ---
!/Tantra_Design/
/Tantra_Design/assets/
/Tantra_Design/bx/
/Tantra_Design/mpfbu/
/Tantra_Design/blender/renders/
/Tantra_Design/blender/textures/
/Tantra_Design/backup_*/
/Tantra_Design/blender/backup_*/
/Tantra_Design/presentation/img_alpha_backup/
__pycache__/
*.blend
*.blend1

# --- starship Tantra: sources (and the ship-view screens it builds with) ---
!/Orbitersdk/samples/
/Orbitersdk/samples/*
!/Orbitersdk/samples/Tantra/
/Orbitersdk/samples/Tantra/build/
/Orbitersdk/samples/Tantra/docs/PORTING_UACS.md
!/Orbitersdk/samples/ShipView/

# --- starship Tantra: assets, configs, scenarios, sounds (built modules stay local) ---
!/Meshes/
/Meshes/*
!/Meshes/Tantra/
!/Textures/
/Textures/*
!/Textures/Tantra/
!/Textures/Tantra_*.dds
!/Config/Vessels/Tantra.cfg
!/Config/Vessels/TantraTrap.cfg
!/Config/Vessels/Tantra/
!/Scenarios/Tantra/
!/XRSound/
/XRSound/*
!/XRSound/Tantra/

# --- build artifacts and local copies (never committed) ---
*.exe
*.obj
*.pdb
*.ilk
*.exp
*.lib
*.iobj
*.ipdb
*.log
*.bak
*.bak_*

# --- beta README with images ---
!/Doc/
/Doc/*
!/Doc/TantraCrew/

# --- MPU (universal mobile platform): sources, meshes, textures, configs, scenarios ---
!/Orbitersdk/samples/MPU/
/Orbitersdk/samples/MPU/build/
!/Meshes/MPU/
!/Textures/MPU/
!/Config/Vessels/MPU.cfg
!/Config/Vessels/EMPU.cfg
!/Scenarios/MPU/
# local test scenarios
/Scenarios/Tantra/_ClaudeTest/
!/Orbitersdk/samples/TVehicles/
/Orbitersdk/samples/TVehicles/build/
!/Config/Vessels/TVehicles/
!/Meshes/TVehicles/

# --- Tantra's lander (спасательная ракета): sources and tests ---
!/Orbitersdk/samples/TantraLander/
/Orbitersdk/samples/TantraLander/build/
/Orbitersdk/samples/TantraLander/tests/lander_obj/
