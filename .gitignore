# Whitelist: this repository lives in the root of an Orbiter 2016 installation.
# Everything is ignored except the project files listed below.
/*
!/.gitignore
!/README.md

# --- design: Blender scripts, sketches, mocap, audio (tools and generated outputs stay local) ---
!/Tantra_Design/
/Tantra_Design/assets/
/Tantra_Design/bx/
/Tantra_Design/mpfbu/
/Tantra_Design/blender/renders/
/Tantra_Design/blender/textures/
__pycache__/
*.blend
*.blend1
*.log
*.bak

# --- SDK property sheet used to build OrbiterCrew / Tantra with VS2022 ---
!/Orbitersdk/
/Orbitersdk/*
!/Orbitersdk/resources/
/Orbitersdk/resources/*
!/Orbitersdk/resources/Orbiter.props

# --- OrbiterCrew: own crew system (sources, config, scenarios) ---
!/Orbitersdk/OrbiterCrew/
/Orbitersdk/OrbiterCrew/build/
/Orbitersdk/OrbiterCrew/*.user
!/Config/
/Config/*
!/Config/Vessels/
/Config/Vessels/*
!/Config/Vessels/OrbiterCrew/
!/Config/OrbiterCrew/
!/Scenarios/
/Scenarios/*
!/Scenarios/OrbiterCrew/

# --- starship Tantra: sources, assets, configs, scenarios, sounds (built modules stay local) ---
!/Orbitersdk/samples/
/Orbitersdk/samples/*
!/Orbitersdk/samples/Tantra/
/Orbitersdk/samples/Tantra/build/
/Orbitersdk/samples/Tantra/docs/PORTING_UACS.md
!/Meshes/
/Meshes/*
!/Meshes/Tantra/
!/Textures/
/Textures/*
!/Textures/Tantra/
!/Textures/Tantra_*.dds
!/Config/Vessels/Tantra.cfg
!/Config/Vessels/TantraTrap.cfg
!/Scenarios/Tantra/
!/XRSound/
/XRSound/*
!/XRSound/Tantra/

# --- build artifacts (never committed) ---
*.exe
*.obj
*.pdb
*.ilk
*.exp
*.iobj
*.ipdb
