+			char buf[160]; sprintf_s(buf, "AtmoFX: particle wind x%.3f for [%s]", k, name); oapiWriteLog(buf);
+		}
+		oapiCloseFile(f, FILE_IN_ZEROONFAIL);
+	}
+	cache[hPlanet] = k;
